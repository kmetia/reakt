{:paths ["src" "test"]
 :tasks
 {test {:doc "Run the reakt suite"
        :task (let [run-tests (requiring-resolve 'clojure.test/run-tests)
                    nss '[kmet.reakt.test-reakt
                          kmet.reakt.test-reakt-features
                          kmet.reakt.test-weak]]
                (doseq [ns-sym nss] (require ns-sym))
                (let [{:keys [fail error]} (apply run-tests nss)]
                  (when (pos? (+ fail error))
                    (System/exit 1))))}}}
